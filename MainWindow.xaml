<Window x:Class="QueryBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fatura Query Builder"
        Width="820" Height="780"
        MinWidth="620" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Border CornerRadius="20" ClipToBounds="True">

        <!-- ═══ LAYERED BACKGROUND ═══ -->
        <Grid>

            <!-- Layer 0 – deep dark base -->
            <Border CornerRadius="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF080A14" Offset="0"/>
                        <GradientStop Color="#FF0D1025" Offset="0.5"/>
                        <GradientStop Color="#FF0F0820" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Layer 1 – large ambient glow (top-left purple) -->
            <Ellipse Width="500" Height="500"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-120,-100,0,0" Opacity="0.12" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{StaticResource AccentPurple}" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Layer 2 – ambient glow (bottom-right cyan) -->
            <Ellipse Width="440" Height="440"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-80,-60" Opacity="0.10" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{StaticResource AccentCyan}" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Layer 3 – small pink accent glow -->
            <Ellipse Width="260" Height="260"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-40,-40,0" Opacity="0.07" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{StaticResource AccentPink}" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- ═══ MAIN CONTENT ═══ -->
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>   <!-- Title bar -->
                    <RowDefinition Height="*"/>    <!-- Content -->
                    <RowDefinition Height="Auto"/> <!-- Snackbar area -->
                </Grid.RowDefinitions>

                <!-- ── CUSTOM TITLE BAR ── -->
                <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <!-- App icon -->
                        <Border Width="26" Height="26" CornerRadius="7" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource AccentPurple}" Offset="0"/>
                                    <GradientStop Color="{StaticResource AccentCyan}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="Q" FontWeight="Bold" FontSize="13"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Query Builder" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Window controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Style="{StaticResource IconButton}" Width="34" Height="34"
                                Click="MinimizeBtn_Click" ToolTip="Minimize">
                            <TextBlock Text="─" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="13" Margin="0,-3,0,0"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="34" Height="34"
                                Margin="4,0,0,0" Click="MaximizeBtn_Click" ToolTip="Maximize">
                            <TextBlock Text="□" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="14" Margin="0,-2,0,0"/>
                        </Button>
                        <Button x:Name="CloseBtn" Width="34" Height="34" Cursor="Hand"
                                Margin="4,0,0,0" Click="CloseBtn_Click" ToolTip="Close">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="10"
                                            Background="#18FFFFFF"
                                            BorderBrush="{StaticResource GlassBorderBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="✕" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#44EF4444"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ── SCROLLABLE CONTENT ── -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="28,4,28,28">
                    <StackPanel>

                        <!-- HEADER -->
                        <TextBlock FontSize="28" FontWeight="Bold" Margin="0,4,0,2">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{StaticResource AccentPurple}" Offset="0"/>
                                    <GradientStop Color="{StaticResource AccentCyan}"   Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                            Fatura Query Builder
                        </TextBlock>
                        <TextBlock Text="Paste Fatura Subject lines below — each line becomes a search condition."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="13" Margin="0,0,0,22"/>

                        <!-- ── INPUT PANEL ── -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="INPUT" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="2,0,0,10"/>
                                <TextBox x:Name="InputBox"
                                         Style="{StaticResource GlassTextBox}"
                                         Height="160"
                                         VerticalScrollBarVisibility="Auto"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Text=""
                                         TextChanged="InputBox_TextChanged"/>
                                <TextBlock x:Name="LineCountText"
                                           Text="0 lines"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11" Margin="4,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- ── CONVERT BUTTON ── -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="⚡  Generate Fatura Query"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="GenerateBtn_Click"
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"/>
                            <Button Content="🗑  Clear"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ClearBtn_Click"
                                    Grid.Column="1" Margin="10,0,0,0"/>
                        </Grid>

                        <!-- ── OUTPUT PANEL ── -->
                        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="OUTPUT" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="2,0,0,0"/>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="16,8" Click="CopyBtn_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋" FontSize="13" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="CopyBtnText" Text="Copy" FontSize="12"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBox x:Name="OutputBox"
                                         Style="{StaticResource GlassTextBox}"
                                         Height="120"
                                         IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap"
                                         Text=""/>
                            </StackPanel>
                        </Border>

                        <!-- ── STATS BAR ── -->
                        <Border Style="{StaticResource GlassPanel}" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="Lines" FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="StatLines" Text="0" FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{StaticResource AccentPurple}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="Conditions" FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="StatConditions" Text="0" FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{StaticResource AccentCyan}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="Characters" FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="StatChars" Text="0" FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{StaticResource AccentPink}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ── SNACKBAR OVERLAY ── -->
                <Border x:Name="SnackbarContainer"
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,16"
                        Visibility="Collapsed"
                        Opacity="0"
                        CornerRadius="12"
                        Padding="20,12"
                        IsHitTestVisible="False">
                    <Border.Background>
                        <SolidColorBrush Color="{StaticResource AccentPurple}" Opacity="0.92"/>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="4"
                                          Color="#80000000" Opacity="0.5"/>
                    </Border.Effect>
                    <TextBlock x:Name="SnackbarText"
                               Text="" FontSize="13" FontWeight="SemiBold"
                               Foreground="White"/>
                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>
